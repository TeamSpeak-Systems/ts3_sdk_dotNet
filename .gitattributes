# Normalize line endings on commit; check out with the platform's native endings.
* text=auto

# Source and text files
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.config    text
*.json      text
*.md        text
*.xml       text
*.plist     text
*.storyboard text
*.axml      text
*.sh        text eol=lf

# Files that require CRLF
*.sln       text eol=crlf

# Binary files (never normalize)
*.png       binary
*.jpg       binary
*.ico       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.a         binary
*.lib       binary
*.pdb       binary
*.pfx       binary
*.snk       binary
*.tar.gz    binary
*.zip       binary
